# BedForge environment — never commit real secrets.
# Copy values you need into backend/.env locally.
# Demo plant logins are always seeded:
#   admin@bedforge.com / admin123
#   supervisor@bedforge.com / super123
#   qc@bedforge.com / qc123
#   production@bedforge.com / prod123
# Optional extra owner (does not replace demo Plant Admin):
ADMIN_EMAIL=plant.manager@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
BEDFORGE_ENV=development
BEDFORGE_DEMO_USERS=1
BEDFORGE_ALLOW_REGISTER=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local default: in-memory store. Use mongodb://... when Mongo is running.
MONGO_URL=memory://local
DB_NAME=bedforge_dev
JWT_SECRET=replace-with-32-plus-random-characters
FILE_ENCRYPTION_KEY=replace-with-a-second-32-plus-random-key
PUBLIC_APP_URL=http://localhost:3000
SESSION_MINUTES=480
IDLE_MINUTES=30
# Optional: Forge Coach / mill-tag vision. Leave empty to use on-device answers only.
OPENAI_API_KEY=
# Frontend (CRA) — set at npm start / npm run build time, not in backend/.env
# REACT_APP_BACKEND_URL=http://localhost:8000
