# BedForge environment — never commit real secrets.
# Copy to backend/.env locally.

JWT_SECRET=replace-with-32-plus-random-characters
FILE_ENCRYPTION_KEY=replace-with-a-second-32-plus-random-key
ADMIN_EMAIL=plant.manager@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
BEDFORGE_ENV=development
BEDFORGE_DEMO_USERS=1
BEDFORGE_ALLOW_REGISTER=0
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=bedforge_qc
PUBLIC_APP_URL=http://localhost:3000
SESSION_MINUTES=480
IDLE_MINUTES=30
# Optional: Forge Coach / mill-tag vision. Leave empty to use on-device answers only.
OPENAI_API_KEY=
# Frontend (CRA) — set at npm start / npm run build time, not in backend/.env
# REACT_APP_BACKEND_URL=http://localhost:8000
