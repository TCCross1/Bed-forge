MONGO_URL=memory://local
DB_NAME=bedforge_dev
JWT_SECRET=replace-with-a-long-random-secret
# Demo plant logins are always seeded on startup (do not replace these with ADMIN_EMAIL-only):
#   admin@bedforge.com / admin123
#   supervisor@bedforge.com / super123
#   qc@bedforge.com / qc123
#   production@bedforge.com / prod123
# Optional extra owner account (does not remove Plant Admin demo):
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LICENSE_ACTIVATION_KEY=replace-with-a-provisioned-license-key
